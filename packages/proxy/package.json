{
  "name": "poe-editor-proxy",
  "version": "1.39.1",
  "description": "Cloudflare Worker for dynamic Open Graph previews and root-level routing",
  "main": "dist/worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml --env dev",
    "dev:remote": "wrangler dev --remote --config wrangler.toml --env dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
