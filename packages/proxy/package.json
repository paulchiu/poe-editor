{
  "name": "poe-editor-proxy",
  "version": "1.32.0",
  "description": "Cloudflare Worker for dynamic Open Graph previews and root-level routing",
  "main": "dist/worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml --env dev",
    "dev:remote": "wrangler dev --remote --config wrangler.toml --env dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "miniflare": "^4.20260617.1",
    "prettier": "^3.9.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.93.0"
  }
}
