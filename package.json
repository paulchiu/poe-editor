{
  "name": "poe-editor",
  "version": "1.32.0",
  "description": "A Markdown editor with vim support - Monorepo",
  "author": "Poe",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:app\" \"npm:dev:proxy\" --names \"app,proxy\" --prefix-colors \"blue,green\"",
    "dev:app": "npm run dev -w packages/app",
    "dev:proxy": "npm run dev -w packages/proxy",
    "build": "npm run build -w packages/app",
    "build:proxy": "npm run build -w packages/proxy",
    "generate:og": "npm run generate -w packages/og-generator",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "tsc": "npm run tsc --workspaces --if-present",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "test": "npm test -w packages/app",
    "test:coverage": "npm run test:coverage -w packages/app",
    "test:e2e": "npm run test:e2e -w packages/app",
    "deploy:app": "npm run deploy -w packages/app",
    "deploy:proxy": "npm run deploy -w packages/proxy",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "overrides": {
    "dompurify": "3.4.2",
    "lodash-es": "4.18.1",
    "monaco-editor": {
      "dompurify": "3.4.2"
    },
    "smol-toml": "1.6.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.2",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
}
